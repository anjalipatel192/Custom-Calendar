# Environment Configuration Template
# Copy this file to '.env' and populate with local development overrides if needed.
# Do NOT commit actual '.env' files to version control.

# Application Environment (development, staging, production)
APP_ENV=development

# Base URL for remote API integration (if dynamic calendar sync is enabled)
API_BASE_URL="https://api.example.com/v1"

# Calendar Data Source Provider: 'local' (bundled JSON) or 'remote' (REST/GraphQL API)
CALENDAR_DATA_SOURCE=local

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_DEBUG_LOGS=false
